# ==============================================================================
# SismoWatch - Variables de Entorno de Configuración
# Copiar este archivo a .env antes de levantar con docker compose up -d
# ADVERTENCIA: El archivo .env REAL nunca debe commitearse al repositorio Git
# ==============================================================================

# --- PostgreSQL - Configuración Principal y Superusuario ---
POSTGRES_DB=sismowatch_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_master_secure_pwd_change_me
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# --- PostgreSQL - Contraseñas de Roles de Mínimo Privilegio (POLP) ---
DB_INGESTION_USER=user_ingestion
DB_INGESTION_PASSWORD=ingestion_secret_change_me

DB_TRANSFORMATION_USER=user_transformation
DB_TRANSFORMATION_PASSWORD=transformation_secret_change_me

DB_API_READER_USER=user_api_reader
DB_API_READER_PASSWORD=api_reader_secret_change_me

DB_CHAT_READER_USER=user_chat_reader
DB_CHAT_READER_PASSWORD=chat_reader_secret_change_me

DB_API_LOGGER_USER=user_api_logger
DB_API_LOGGER_PASSWORD=api_logger_secret_change_me

# --- Apache Airflow ---
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
AIRFLOW__CORE__FERNET_KEY=YOUR_FERNET_KEY_HERE_USE_cryptography.fernet
AIRFLOW__CORE__SECRET_KEY=YOUR_WEB_SECRET_KEY_CHANGE_ME
_AIRFLOW_WWW_USER_USERNAME=sismo_admin
_AIRFLOW_WWW_USER_PASSWORD=sismo_admin_secure_pwd_change_me

# Airflow REST API (Utilizada por FastAPI para Backfill y Regenerar Reporte)
AIRFLOW_API_URL=http://airflow-webserver:8080/api/v1
AIRFLOW_API_USER=sismo_admin
AIRFLOW_API_PASSWORD=sismo_admin_secure_pwd_change_me

# Alerting Webhook (on_failure_callback)
FAILURE_ALERT_WEBHOOK_URL=https://webhook.site/placeholder-alert-url

# --- Plataforma Web y Seguridad (FastAPI) ---
API_PORT=8000
JWT_SECRET_KEY=super_secure_jwt_secret_key_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Usuarios Sembrados en Memoria (RBAC: viewer y admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_sismowatch_2026_pwd
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=viewer_sismowatch_2026_pwd

# --- Agente de IA Local (Ollama) ---
# En Docker en Linux: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# --- Frontend Web ---
WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:8000

# --- MinIO Object Storage (Data Lakehouse Parquet) ---
MINIO_ROOT_USER=sismowatch_minio_admin
MINIO_ROOT_PASSWORD=minio_master_secure_pwd_change_me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=sismowatch-lake

# --- Groq Cloud AI Provider (Opcional) ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b


